ADS_MODE=mock
ADS_DATABASE=var/ads.sqlite3
ADS_API_KEYS={"local":"local-dev-key"}
ADS_NORMALIZATION_FILE=config/url-normalization.json
ADS_FIXTURE_FILE=fixtures/google_ads.json
ADS_API_VERSION=v23

# Required in live mode. Generate stable encryption key and unique integration API keys.
# ADS_ENCRYPTION_KEY=
# ADS_API_KEYS={"your-service":"replace-with-a-random-secret-of-at-least-32-characters"}
# ADS_CLIENT_ID=your-client-id.apps.googleusercontent.com
# ADS_CLIENT_SECRET=
ADS_REDIRECT_URI=http://localhost:8000/oauth/callback

# Legacy compatibility only; no longer required by current Google onboarding.
# ADS_DEVELOPER_TOKEN=

# Used only by deploy/compose.aws.yaml:
# ADS_DOMAIN=ads-api.example.com
